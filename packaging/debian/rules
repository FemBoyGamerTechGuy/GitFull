#!/usr/bin/make -f
# gitfull — Debian package build rules.
#
# Quick path: ./packaging/build-deb.sh  (extracts the git-archive source
# tree, layers packaging/debian on top as ./debian, runs
# dpkg-buildpackage -us -uc -b).
#
# Design notes (docs/PACKAGING.md has the full rationale):
#   * binary -> /usr/bin/gitfull: distro-owned tree. /usr/local/bin stays
#     gitfull's own territory for the apps IT installs.
#   * /etc/gitfull.conf.example only, declared as a conffile — the user's
#     /etc/gitfull.conf is never owned by this package, so upgrades can
#     never touch it.
#   * nothing creates /var/lib/gitfull at package-install time: gitfull
#     creates it on the first state-changing run (cfg.ensure_root()).
#     There are no maintainer scripts (no postinst/prerm) by design.

%:
        dh $@

override_dh_auto_build:
        cargo build --release --locked

override_dh_auto_test:
        # offline test suite (96+ tests)
        cargo test --release --locked --quiet

override_dh_auto_install:
        install -Dm755 target/release/gitfull debian/gitfull/usr/bin/gitfull
        install -Dm644 config/gitfull.conf.example \
                debian/gitfull/etc/gitfull.conf.example
        # dh_compress (standard sequence) gzips man pages at package build
        # time; install the source form here
        install -Dm644 docs/gitfull.1 debian/gitfull/usr/share/man/man1/gitfull.1
